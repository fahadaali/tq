# انسخ هذا الملف إلى .env للتطوير المحلي مع Supabase (لا تضع .env في git).
# على Render تُضاف هذه القيم في Environment وليس في ملف.

# رابط مشروع Supabase: Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# مفتاح الخدمة السرّي: Project Settings → API Keys → service_role (سرّي للغاية، للخادم فقط)
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# (اختياري) اسم الجدول، الافتراضي responses
# SUPABASE_TABLE=responses

# (اختياري) المنفذ محلياً، الافتراضي 3000. Render يضبطه تلقائياً.
# PORT=3000
